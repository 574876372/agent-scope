<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.cl.agent</groupId>
        <artifactId>agent-scope</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>agent-scope-web</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.cl.agent</groupId>
            <artifactId>agent-scope-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cl.agent</groupId>
            <artifactId>agent-scope-biz</artifactId>
        </dependency>
        <!-- SQL Agent 工具包：通过 agent.sql.enabled=true 启用，宿主在 biz 层提供 DatasourceProvider / SqlAuditPublisher 实现 -->
        <dependency>
            <groupId>com.cl.agent</groupId>
            <artifactId>agent-scope-sql-spring-boot-starter</artifactId>
        </dependency>
        <!-- RAG Agent 知识库插件：通过 agent.rag.enabled=true 启用 -->
        <dependency>
            <groupId>com.cl.agent</groupId>
            <artifactId>agent-scope-rag-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- reactor-core: Spring MVC Flux 流式响应支持（版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
