<?xml version="1.0" encoding="UTF-8"?>
<!--
    ╔══════════════════════════════════════════════════════════════╗
    ║              Agent-Scope 企业级日志配置                       ║
    ║  - 异步 Appender 提升吞吐量                                  ║
    ║  - 按天 + 按大小滚动，总容量上限自动清理                        ║
    ║  - ERROR / WARN 独立日志文件，便于监控告警                     ║
    ║  - dev / prod 环境差异化级别                                  ║
    ╚══════════════════════════════════════════════════════════════╝
-->
<configuration scan="true" scanPeriod="30 seconds">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- ======================== 全局属性 ======================== -->
    <property name="LOG_PATH" value="logs"/>
    <property name="APP_NAME" value="agent-scope"/>
    <!-- 单个日志文件最大大小 -->
    <property name="MAX_FILE_SIZE" value="100MB"/>
    <!-- 历史日志保留天数 -->
    <property name="MAX_HISTORY" value="30"/>
    <!-- 全量日志总容量上限（超过后自动删除最旧归档） -->
    <property name="TOTAL_SIZE_CAP" value="5GB"/>
    <!-- 错误日志总容量上限 -->
    <property name="ERROR_TOTAL_SIZE_CAP" value="2GB"/>

    <!-- 控制台日志格式（带颜色 + 线程 + traceId 占位） -->
    <property name="CONSOLE_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%15.15thread]){faint} %clr(%logger{50}){cyan} %clr(:){faint} %msg%n"/>
    <!-- 文件日志格式（无颜色，含线程名） -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%15.15thread] %logger{50} - %msg%n"/>


    <!-- ===================== 同步 Appender ===================== -->

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全量日志：按天 + 按大小滚动 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- 仅 ERROR 级别日志 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${ERROR_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- 仅 WARN 级别日志（便于监控预警） -->
    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-warn.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-warn.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${ERROR_TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>


    <!-- =================== 异步 Appender 包装 =================== -->
    <!-- 异步写入，提升高并发场景下的吞吐量，队列满时丢弃 TRACE/DEBUG -->

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>20</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE"/>
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <appender name="ASYNC_WARN_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="WARN_FILE"/>
    </appender>


    <!-- =================== 环境差异化配置 =================== -->

    <!-- 开发环境：应用包 DEBUG，框架 INFO -->
    <springProfile name="dev,default">
        <!-- Controller 层：DEBUG，方便查看入参/返回 -->
        <logger name="com.cl.agent.config.ControllerLogAspect" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </logger>

        <!-- SQL 日志（自定义拦截器） -->
        <logger name="SQL" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </logger>

        <!-- 应用包 -->
        <logger name="com.cl.agent" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
            <appender-ref ref="ASYNC_WARN_FILE"/>
        </logger>
    </springProfile>

    <!-- 生产环境：应用包 INFO，控制台关闭 -->
    <springProfile name="prod">
        <logger name="com.cl.agent.config.ControllerLogAspect" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </logger>

        <logger name="SQL" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
        </logger>

        <logger name="com.cl.agent" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
            <appender-ref ref="ASYNC_WARN_FILE"/>
        </logger>
    </springProfile>


    <!-- =================== 框架噪音抑制 =================== -->
    <logger name="org.springframework"        level="WARN"/>
    <logger name="org.mybatis"                level="WARN"/>
    <logger name="org.apache.ibatis"          level="WARN"/>
    <logger name="com.alibaba.druid"          level="WARN"/>
    <logger name="org.hibernate.validator"    level="WARN"/>
    <logger name="io.netty"                   level="WARN"/>
    <logger name="io.lettuce"                 level="WARN"/>


    <!-- ===================== 根日志 ===================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
        <appender-ref ref="ASYNC_WARN_FILE"/>
    </root>

</configuration>
